# ============================================================
# SignalForge - Git Ignore
# ============================================================

# ------------------------------------------------------------
# Environment & Secrets
# ------------------------------------------------------------

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

*.pem
*.key

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

*.so

.Python
.python-version

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / linting
.mypy_cache/
.pyre/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# ------------------------------------------------------------
# Node / Next.js
# ------------------------------------------------------------

node_modules/
.next/
out/
dist/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/

# ------------------------------------------------------------
# Frontend environment files
# ------------------------------------------------------------

frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ------------------------------------------------------------
# Data
# ------------------------------------------------------------

# Ignore potentially large/private datasets
data/raw/*
data/processed/*
data/interim/*
data/features/*

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep
!data/features/.gitkeep

# ------------------------------------------------------------
# ML model artifacts
# ------------------------------------------------------------

ml/models/*
!ml/models/.gitkeep

*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.safetensors

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log
logs/

# ------------------------------------------------------------
# OS generated files
# ------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# IDE / Editor
# ------------------------------------------------------------

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/
*.swp
*.swo

# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.cache

tmp/
temp/

# ------------------------------------------------------------
# Database local files
# ------------------------------------------------------------

*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------
# Coverage / reports
# ------------------------------------------------------------

coverage/
reports/

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------

docker-compose.override.yml
